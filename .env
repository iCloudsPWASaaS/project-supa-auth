# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Per-app Postgres schema (app_<appId>), defaults to "public" when unset
NEXT_PUBLIC_SUPABASE_SCHEMA=

# Demo account. The row is seeded by extra.sql at provision time; these two
# values must match the INSERT in that file, and are what the dashboard reads
# back out of this env to show the owner.
DEMO_ADMIN_EMAIL=demo@iclouds.co.uk
DEMO_ADMIN_PASSWORD=123456