# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Per-app Postgres schema (app_<appId>), defaults to "public" when unset
NEXT_PUBLIC_SUPABASE_SCHEMA=

# Demo account. The row itself is seeded by extra.sql at provision time; these
# two values are what the dashboard reads back out of the app's .env to show the
# owner, and they must match the INSERT in extra.sql. Change one, change both.
DEMO_ADMIN_EMAIL=demo@weblify.app
DEMO_ADMIN_PASSWORD=kR7mq2Xp9vT4
